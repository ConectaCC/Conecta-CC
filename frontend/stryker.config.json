{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "testRunner": "vitest",
  "vitest": {
    "related": false
  },
  "coverageAnalysis": "perTest",
  "mutate": [
    "src/**/*.{ts,tsx}",
    "!src/**/*.test.{ts,tsx}",
    "!src/test/**",
    "!src/components/ui/**",
    "!src/lib/api/schema.d.ts",
    "!src/main.tsx",
    "!src/vite-env.d.ts"
  ],
  "mutator": {
    "excludedMutations": [
      "StringLiteral"
    ]
  },
  "reporters": [
    "clear-text",
    "progress",
    "html"
  ],
  "htmlReporter": {
    "fileName": "reports/mutation/index.html"
  },
  "thresholds": {
    "high": 90,
    "low": 80,
    "break": 80
  },
  "tempDirName": "node_modules/.stryker-tmp"
}
